{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physics-project-b",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "project.class9hub.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
